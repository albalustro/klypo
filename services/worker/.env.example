# Worker (servidor). Variáveis marcadas SECRETO nunca vão para o app nem para o repositório.
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres   # SECRETO (supabase start imprime a URL local)
SUPABASE_URL=http://127.0.0.1:54321                                     # público
SUPABASE_SERVICE_ROLE_KEY=<service role do seu projeto>                 # SECRETO
AI_PROVIDER=fake                                                        # fake (somente dev/teste) | anthropic
ANTHROPIC_API_KEY=<chave do provedor de IA>                             # SECRETO (só se AI_PROVIDER=anthropic)
AI_MODEL=claude-opus-5-5                                                # modelo é configuração, não código
WORKER_ID=worker-local
POLL_INTERVAL_MS=2000
LEASE_SECONDS=120
MAX_IMAGE_BYTES=15728640
