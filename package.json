{
  "name": "klypo",
  "private": true,
  "version": "0.1.0",
  "description": "Klypo — base de conhecimento pessoal a partir de capturas",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test -w @klypo/shared -w mobile",
    "test:db": "bash scripts/with-test-db.sh npm run test -w @klypo/db-tests -w @klypo/worker",
    "test:all": "npm run test && npm run test:db",
    "worker": "npm run start -w @klypo/worker",
    "worker:once": "npm run once -w @klypo/worker",
    "app": "npm run start -w mobile",
    "e2e:supabase": "node scripts/e2e-supabase.mjs"
  },
  "overrides": {
    "react": "19.2.3",
    "react-native": "0.86.3"
  }
}
