{
  "name": "klypo",
  "private": true,
  "version": "0.1.0",
  "description": "Klypo — base de conhecimento pessoal a partir de capturas",
  "workspaces": ["apps/*", "packages/*", "services/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "bash scripts/with-test-db.sh npm run test --workspace @klypo/db-tests",
    "worker": "npm run start --workspace @klypo/worker",
    "app": "npm run start --workspace mobile"
  }
}
