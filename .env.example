# Raiz: apenas nomes e placeholders. Copie os arquivos específicos:
#   apps/mobile/.env.example      -> apps/mobile/.env      (variáveis PÚBLICAS EXPO_PUBLIC_*)
#   services/worker/.env.example  -> services/worker/.env  (inclui SEGREDOS; nunca commitar)
#
# PÚBLICAS (vão no bundle do app): EXPO_PUBLIC_SUPABASE_URL, EXPO_PUBLIC_SUPABASE_ANON_KEY
# SECRETAS (somente servidor/worker): DATABASE_URL, SUPABASE_SERVICE_ROLE_KEY, ANTHROPIC_API_KEY
# Testes de banco: TEST_PG_ADMIN_URL=postgres://postgres@localhost:5432/postgres  (Postgres descartável; veja scripts/with-test-db.sh)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
